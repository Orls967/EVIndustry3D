{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ev-pack-twin.local/schema/pack.schema.json",
  "title": "PackDefinition",
  "type": "object",
  "required": [
    "id",
    "displayName",
    "description",
    "provenanceNote",
    "cell",
    "seriesCount",
    "parallelCount",
    "envelopeMm",
    "cooling",
    "zones",
    "coolantPath",
    "components"
  ],
  "properties": {
    "id": { "type": "string", "enum": ["LFP_BLADE", "NMC_4680"] },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "provenanceNote": { "type": "string", "minLength": 1 },
    "cell": {
      "type": "object",
      "required": [
        "formFactor",
        "dimensionsMm",
        "massKg",
        "nominalCapacityAh",
        "nominalVoltageV",
        "specificHeatJPerKgK",
        "kThroughPlaneWPerMK",
        "kInPlaneWPerMK",
        "sourceRefs"
      ],
      "properties": {
        "formFactor": { "type": "string", "enum": ["PRISMATIC_BLADE", "CYLINDRICAL"] },
        "dimensionsMm": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 2, "maxItems": 3 },
        "massKg": { "type": "number", "exclusiveMinimum": 0 },
        "nominalCapacityAh": { "type": "number", "exclusiveMinimum": 0 },
        "nominalVoltageV": { "type": "number", "exclusiveMinimum": 0 },
        "specificHeatJPerKgK": { "type": "number", "exclusiveMinimum": 0 },
        "specificHeatTempCoeffPctPerK": { "type": "number" },
        "kThroughPlaneWPerMK": { "type": "number", "exclusiveMinimum": 0 },
        "kInPlaneWPerMK": { "type": "number", "exclusiveMinimum": 0 },
        "sourceRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "seriesCount": { "type": "integer", "minimum": 1 },
    "parallelCount": { "type": "integer", "minimum": 1 },
    "envelopeMm": {
      "type": "object",
      "required": ["lengthX", "heightY", "widthZ", "interCellGapMm", "provenance"],
      "properties": {
        "lengthX": { "type": "number", "exclusiveMinimum": 0 },
        "heightY": { "type": "number", "exclusiveMinimum": 0 },
        "widthZ": { "type": "number", "exclusiveMinimum": 0 },
        "interCellGapMm": { "type": "number", "minimum": 0 },
        "enclosureWallMm": { "type": "number", "exclusiveMinimum": 0 },
        "timThicknessMm": { "type": "number", "exclusiveMinimum": 0 },
        "timConductivityWPerMK": { "type": "number", "exclusiveMinimum": 0 },
        "provenance": { "type": "string", "enum": ["SOURCED", "DERIVED", "ASSUMED"] }
      }
    },
    "cooling": {
      "type": "object",
      "required": [
        "topology",
        "channelWidthMm",
        "channelHeightMm",
        "parallelChannels",
        "nusseltNumber",
        "nusseltBoundaryCondition",
        "contactAreaPerZoneM2",
        "rZoneToCoolantBaseKW",
        "rZoneToZoneKW",
        "rZoneToAmbientKW",
        "provenance"
      ],
      "properties": {
        "topology": { "type": "string", "enum": ["TOP_COLD_PLATE", "SIDE_CHANNELS"] },
        "channelWidthMm": { "type": "number", "exclusiveMinimum": 0 },
        "channelHeightMm": { "type": "number", "exclusiveMinimum": 0 },
        "parallelChannels": { "type": "integer", "minimum": 1 },
        "nusseltNumber": { "type": "number", "exclusiveMinimum": 0 },
        "nusseltBoundaryCondition": { "type": "string", "enum": ["UNIFORM_WALL_TEMP", "UNIFORM_WALL_FLUX"] },
        "contactAreaPerZoneM2": { "type": "number", "exclusiveMinimum": 0 },
        "rZoneToCoolantBaseKW": { "type": "number", "minimum": 0 },
        "rZoneToZoneKW": { "type": "number", "exclusiveMinimum": 0 },
        "rZoneToAmbientKW": { "type": "number", "exclusiveMinimum": 0 },
        "provenance": { "type": "string", "enum": ["SOURCED", "DERIVED", "ASSUMED"] }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "cellCount", "order", "thermalMassJPerK"],
        "properties": {
          "id": { "type": "string", "pattern": "^pack\\.zone_[0-9]{2}$" },
          "cellCount": { "type": "integer", "minimum": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "thermalMassJPerK": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "coolantPath": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^pack\\.zone_[0-9]{2}$" }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "func", "location", "parameters", "failureModes", "provenance", "explode"],
        "properties": {
          "id": { "type": "string", "pattern": "^pack\\.[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "func": { "type": "string", "minLength": 1 },
          "material": { "type": "string" },
          "location": { "type": "string", "minLength": 1 },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string" },
                "value": { "type": "string" },
                "unit": { "type": "string" },
                "sourceRef": { "type": "string" }
              }
            }
          },
          "failureModes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["mode", "effect"],
              "properties": {
                "mode": { "type": "string" },
                "effect": { "type": "string" }
              }
            }
          },
          "provenance": { "type": "string", "enum": ["GENERIC_EDUCATIONAL", "SOURCED"] },
          "explode": {
            "type": "object",
            "required": ["stage", "offsetM"],
            "properties": {
              "stage": { "type": "integer", "minimum": 0 },
              "offsetM": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
            }
          },
          "zoneId": { "type": "string" }
        }
      }
    }
  }
}

